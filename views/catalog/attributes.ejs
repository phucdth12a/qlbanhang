<%- include('../partials/header') %>
<%- include('../partials/pagehead', { heading: 'Thuộc tính biến thể', sub: 'Dùng để tạo biến thể sản phẩm, ví dụ Size S / M / L, Màu Đen / Trắng.' }) %>
<div class="row g-3">
  <div class="col-lg-8 d-flex flex-column gap-3">
    <% attributes.forEach(a => { %>
      <div class="card">
        <div class="card-header d-flex justify-content-between"><span><%= a.name %></span><span class="mono text-body-secondary"><%= a.code %></span></div>
        <div class="card-body d-flex flex-column gap-3">
          <div class="d-flex flex-wrap gap-2">
            <% if (!a.values.length) { %><span class="text-body-secondary">Chưa có giá trị.</span><% } %>
            <% a.values.forEach(v => { %>
              <span class="badge text-bg-light border d-inline-flex align-items-center gap-1 fs-6 fw-normal">
                <%= v.value %>
                <% if (can('catalog.manage') && !v.used) { %>
                  <form method="post" action="/attribute-values/<%= v.id %>/delete" class="d-inline" data-confirm="Xoá giá trị <%= v.value %>?"><button class="btn btn-link btn-sm p-0 text-danger" type="submit" aria-label="Xoá <%= v.value %>"><i class="bi bi-x"></i></button></form>
                <% } %>
              </span>
            <% }) %>
          </div>
          <% if (can('catalog.manage')) { %>
            <form method="post" action="/attributes/<%= a.id %>/values" class="d-flex gap-2">
              <input class="form-control form-control-sm" name="values" placeholder="Thêm giá trị, cách nhau bằng dấu phẩy: XXL, 3XL" aria-label="Giá trị mới cho <%= a.name %>">
              <button class="btn btn-sm btn-outline-primary text-nowrap" type="submit">Thêm</button>
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
  <% if (can('catalog.manage')) { %>
  <div class="col-lg-4">
    <form method="post" action="/attributes" class="card">
      <div class="card-header">Thêm thuộc tính</div>
      <div class="card-body d-flex flex-column gap-3">
        <div><label class="form-label" for="code">Mã *</label><input class="form-control" id="code" name="code" placeholder="MATERIAL" required></div>
        <div><label class="form-label" for="aname">Tên *</label><input class="form-control" id="aname" name="name" placeholder="Chất liệu" required></div>
      </div>
      <div class="card-footer"><button class="btn btn-primary" type="submit">Thêm</button></div>
    </form>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
