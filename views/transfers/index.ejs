<%- include('../partials/header') %>
<%- include('../partials/pagehead', { heading: 'Chuyển kho', sub: 'Chuyển hàng giữa các kho hoặc giữa các vị trí trong cùng kho.',
  actions: can('tr.create') ? '<a class="btn btn-primary" href="/transfers/new"><i class="bi bi-plus-lg"></i> Tạo phiếu chuyển</a>' : '' }) %>
<form class="filters" method="get">
  <div class="grow"><label class="form-label small" for="q">Mã phiếu</label><input class="form-control" id="q" name="q" value="<%= f.q %>"></div>
  <div><label class="form-label small" for="status">Trạng thái</label>
    <select class="form-select" id="status" name="status"><option value="">Tất cả</option><% L.options('docStatus').forEach(o => { %><option value="<%= o.value %>" <%= f.status === o.value ? 'selected' : '' %>><%= o.text %></option><% }) %></select>
  </div>
  <div><button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Lọc</button></div>
</form>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead><tr><th>Mã phiếu</th><th>Từ kho</th><th>Đến kho</th><th>Ngày</th><th class="num">SL</th><th>Người lập</th><th>Trạng thái</th></tr></thead>
      <tbody>
        <% if (!rows.length) { %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-arrow-left-right"></i>Chưa có phiếu chuyển kho.</div></td></tr><% } %>
        <% rows.forEach(t => { %>
          <tr><td><a class="mono" href="/transfers/<%= t.id %>"><%= t.code %></a></td><td class="mono"><%= t.from_code %></td><td class="mono"><%= t.to_code %></td>
            <td class="text-nowrap"><%= fmt.date(t.transfer_date) %></td><td class="num"><%= fmt.num(t.qty) %></td><td><%= t.full_name %></td><td><%- L.badge('docStatus', t.status) %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
