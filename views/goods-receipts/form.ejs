<%- include('../partials/header') %>
<%- include('../partials/pagehead', { heading: title, back: gr.id ? '/goods-receipts/' + gr.id : '/purchase-orders/' + po.id,
  sub: `Phiếu mua <a class="mono" href="/purchase-orders/${po.id}">${po.code}</a> · ${po.supplier_name} · Kho: ${po.warehouse_name}` }) %>
<%- include('../partials/formerror') %>
<form method="post" action="/goods-receipts<%= gr.id ? '/' + gr.id : '' %>" class="d-flex flex-column gap-3">
  <input type="hidden" name="purchase_order_id" value="<%= po.id %>">
  <div class="card">
    <div class="card-body row g-3">
      <div class="col-md-3"><label class="form-label" for="receipt_date">Ngày nhập</label><input class="form-control" type="date" id="receipt_date" name="receipt_date" value="<%= gr.receipt_date || '' %>"></div>
      <div class="col-md-3"><label class="form-label" for="delivery_note_no">Số phiếu giao của NCC</label><input class="form-control" id="delivery_note_no" name="delivery_note_no" value="<%= gr.delivery_note_no || '' %>"></div>
      <div class="col-md-6"><label class="form-label" for="note">Ghi chú</label><input class="form-control" id="note" name="note" value="<%= gr.note || '' %>"></div>
    </div>
  </div>
  <div class="card">
    <div class="card-header">Hàng nhận được</div>
    <div class="card-body pb-0 small text-body-secondary">
      <strong>Nhập đạt</strong> là hàng tốt vào kho, chia được vào nhiều vị trí (bấm "+ Vị trí"). Tổng không vượt quá số còn được nhập.
      <strong>Phát sinh</strong> là hàng lỗi, sai mẫu... không vào tồn, được báo cho thu mua. Ghi được nhiều loại (bấm "+ Phát sinh").
      Dòng để trống sẽ không đưa vào phiếu.
    </div>
    <div class="table-responsive">
      <table class="table mb-0 lines-table">
        <thead><tr><th>Sản phẩm</th><th class="num">Mua</th><th class="num">Đã nhập</th><th class="num">Còn được nhập</th><th>Nhập đạt: vị trí · SL</th><th>Phát sinh: loại · SL · mô tả</th></tr></thead>
        <tbody>
          <% const esc = (x) => String(x ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
             rows.forEach((r, i) => {
               const locOpt = (sel) => '<option value="">— Vị trí —</option>' + locations.map(l => `<option value="${l.id}" ${String(sel) === String(l.id) ? 'selected' : ''}>${esc(l.code)}</option>`).join('');
               const typeOpt = (sel) => '<option value="">— Loại —</option>' + L.options('issueType').map(o => `<option value="${o.value}" ${sel === o.value ? 'selected' : ''}>${o.text}</option>`).join('');
               const allocRow = (a, j) => `<tr>
                 <td><select class="form-select form-select-sm" name="lines[${i}][alloc][${j}][location_id]" aria-label="Vị trí cất ${esc(r.sku)}" style="min-width:120px">${locOpt(a.location_id)}</select></td>
                 <td><input class="form-control form-control-sm text-end" type="number" min="1" step="1" name="lines[${i}][alloc][${j}][quantity]" value="${a.quantity || ''}" aria-label="SL đạt ${esc(r.sku)}" style="width:80px"></td>
                 <td><button class="btn btn-sm btn-outline-danger" type="button" data-remove-line aria-label="Xoá"><i class="bi bi-x-lg"></i></button></td></tr>`;
               const issueRow = (x, k) => `<tr>
                 <td><select class="form-select form-select-sm" name="lines[${i}][issues][${k}][issue_type]" aria-label="Loại phát sinh ${esc(r.sku)}" style="min-width:130px">${typeOpt(x.issue_type)}</select></td>
                 <td><input class="form-control form-control-sm text-end" type="number" min="1" step="1" name="lines[${i}][issues][${k}][quantity]" value="${x.quantity || ''}" aria-label="SL phát sinh ${esc(r.sku)}" style="width:70px"></td>
                 <td><input class="form-control form-control-sm" name="lines[${i}][issues][${k}][description]" value="${esc(x.description)}" placeholder="VD: rách đường may" aria-label="Mô tả phát sinh ${esc(r.sku)}" style="min-width:150px"></td>
                 <td><button class="btn btn-sm btn-outline-danger" type="button" data-remove-line aria-label="Xoá"><i class="bi bi-x-lg"></i></button></td></tr>`; %>
            <tr>
              <td><input type="hidden" name="lines[<%= i %>][po_item_id]" value="<%= r.id %>"><div class="mono"><%= r.sku %></div><div class="small text-body-secondary"><%= r.name %></div></td>
              <td class="num"><%= fmt.num(r.quantity_ordered) %></td>
              <td class="num"><%= fmt.num(r.quantity_received) %><% if (r.qty_pending) { %><div class="small text-warning-emphasis">+<%= r.qty_pending %> chờ duyệt</div><% } %></td>
              <td class="num fw-semibold"><%= fmt.num(Math.max(r.remaining, 0)) %></td>
              <td>
                <div data-lines>
                  <table class="table table-sm table-borderless mb-0"><tbody data-lines-body><%- r.alloc.map((a, j) => allocRow(a, j)).join('') %></tbody></table>
                  <template data-line-template><%- allocRow({}, '__i__') %></template>
                  <button class="btn btn-sm btn-link p-0" type="button" data-add-line>+ Vị trí</button>
                </div>
              </td>
              <td>
                <div data-lines>
                  <table class="table table-sm table-borderless mb-0"><tbody data-lines-body><%- r.issues.map((x, k) => issueRow(x, k)).join('') %></tbody></table>
                  <template data-line-template><%- issueRow({}, '__i__') %></template>
                  <button class="btn btn-sm btn-link p-0" type="button" data-add-line>+ Phát sinh</button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <button class="btn btn-primary" type="submit" name="submit_now" value="1"><i class="bi bi-send"></i> Lưu và gửi duyệt</button>
    <button class="btn btn-outline-primary" type="submit">Lưu nháp</button>
    <a class="btn btn-outline-secondary" href="<%= gr.id ? '/goods-receipts/' + gr.id : '/purchase-orders/' + po.id %>">Huỷ</a>
  </div>
</form>
<%- include('../partials/footer') %>
