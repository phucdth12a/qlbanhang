<%- include('../partials/header') %>
<%- include('../partials/pagehead', { heading: 'Kiểm kê', sub: 'Nhập số đếm thực tế. Khi phiếu được duyệt, tồn hệ thống được đặt bằng số đếm.',
  actions: can('adj.create') ? '<a class="btn btn-primary" href="/adjustments/new"><i class="bi bi-plus-lg"></i> Tạo phiếu kiểm kê</a>' : '' }) %>
<form class="filters" method="get">
  <div><label class="form-label small" for="status">Trạng thái</label>
    <select class="form-select" id="status" name="status"><option value="">Tất cả</option><% L.options('docStatus').forEach(o => { %><option value="<%= o.value %>" <%= f.status === o.value ? 'selected' : '' %>><%= o.text %></option><% }) %></select>
  </div>
  <div><button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Lọc</button></div>
</form>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead><tr><th>Mã phiếu</th><th>Kho</th><th>Ngày</th><th>Lý do</th><th class="num">Số dòng</th><th>Người lập</th><th>Trạng thái</th></tr></thead>
      <tbody>
        <% if (!rows.length) { %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-clipboard-check"></i>Chưa có phiếu kiểm kê.</div></td></tr><% } %>
        <% rows.forEach(a => { %>
          <tr><td><a class="mono" href="/adjustments/<%= a.id %>"><%= a.code %></a></td><td class="mono"><%= a.warehouse_code %></td><td class="text-nowrap"><%= fmt.date(a.adjustment_date) %></td>
            <td><%= a.reason || '' %></td><td class="num"><%= a.line_count %></td><td><%= a.full_name %></td><td><%- L.badge('docStatus', a.status) %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
