<form method="post" action="/warehouses<%= w.id ? '/' + w.id : '' %>" class="card">
  <div class="card-header">Thông tin kho</div>
  <fieldset class="card-body row g-3" <%= can('warehouses.manage') ? '' : 'disabled' %>>
    <div class="col-md-3"><label class="form-label" for="wcode">Mã kho *</label><input class="form-control mono" id="wcode" name="code" value="<%= w.code || '' %>" placeholder="KHO-HN" required></div>
    <div class="col-md-5"><label class="form-label" for="wname">Tên kho *</label><input class="form-control" id="wname" name="name" value="<%= w.name || '' %>" required></div>
    <div class="col-md-4"><label class="form-label" for="manager_id">Quản lý kho</label>
      <select class="form-select" id="manager_id" name="manager_id"><option value="">— Chọn —</option>
        <% managers.forEach(m => { %><option value="<%= m.id %>" <%= String(w.manager_id) === String(m.id) ? 'selected' : '' %>><%= m.full_name %></option><% }) %>
      </select>
    </div>
    <div class="col-md-9"><label class="form-label" for="address">Địa chỉ</label><input class="form-control" id="address" name="address" value="<%= w.address || '' %>"></div>
    <div class="col-md-3 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" id="w_active" name="is_active" value="1" <%= w.is_active ? 'checked' : '' %>><label class="form-check-label" for="w_active">Đang hoạt động</label></div></div>
  </fieldset>
  <% if (can('warehouses.manage')) { %><div class="card-footer"><button class="btn btn-primary" type="submit">Lưu kho</button></div><% } %>
</form>
