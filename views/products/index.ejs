<%- include('../partials/header') %>
<%- include('../partials/pagehead', { heading: 'Sản phẩm', actions: can('catalog.manage') ? '<a class="btn btn-primary" href="/products/new"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>' : '' }) %>
<form class="filters" method="get">
  <div class="grow"><label class="form-label small" for="q">Tìm kiếm</label><input class="form-control" id="q" name="q" value="<%= q %>" placeholder="Mã, tên, SKU, barcode"></div>
  <div><label class="form-label small" for="category_id">Nhóm</label>
    <select class="form-select" id="category_id" name="category_id"><option value="">Tất cả</option>
      <% categories.forEach(c => { %><option value="<%= c.id %>" <%= cat === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
  </div>
  <div><button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Lọc</button></div>
</form>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead><tr><th>Mã</th><th>Tên sản phẩm</th><th>Nhóm</th><th>ĐVT</th><th class="num">Biến thể</th><th class="num">Tồn mới</th><th>Trạng thái</th></tr></thead>
      <tbody>
        <% if (!products.length) { %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-tags"></i>Chưa có sản phẩm phù hợp.</div></td></tr><% } %>
        <% products.forEach(p => { %>
          <tr>
            <td><a class="mono" href="/products/<%= p.id %>"><%= p.code %></a></td>
            <td><a href="/products/<%= p.id %>" class="text-reset"><%= p.name %></a></td>
            <td><%= p.category_name || '' %></td>
            <td><%= p.unit %></td>
            <td class="num"><%= p.variant_count %></td>
            <td class="num"><%= fmt.num(p.stock_new) %></td>
            <td><%- p.is_active ? '<span class="badge text-bg-success">Đang bán</span>' : '<span class="badge text-bg-secondary">Ngừng</span>' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
