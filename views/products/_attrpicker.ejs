<div class="d-flex flex-column gap-3">
  <% attributes.forEach(a => { const sel = (selected && selected[a.id]) ? [].concat(selected[a.id]).map(String) : []; %>
    <div>
      <div class="fw-semibold mb-1"><%= a.name %></div>
      <div class="d-flex flex-wrap gap-3">
        <% a.values.forEach(v => { %>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="attr[<%= a.id %>][]" value="<%= v.id %>" id="av<%= prefix %><%= v.id %>" <%= sel.includes(String(v.id)) ? 'checked' : '' %>>
            <label class="form-check-label" for="av<%= prefix %><%= v.id %>"><%= v.value %></label>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>
  <div class="row g-3">
    <div class="col-sm-6"><label class="form-label" for="cost<%= prefix %>">Giá vốn mặc định</label><input class="form-control" id="cost<%= prefix %>" name="cost_price" type="number" min="0" step="1000" value="<%= (typeof p !== 'undefined' && p.cost_price) || '' %>"></div>
    <div class="col-sm-6"><label class="form-label" for="sale<%= prefix %>">Giá bán mặc định</label><input class="form-control" id="sale<%= prefix %>" name="sale_price" type="number" min="0" step="1000" value="<%= (typeof p !== 'undefined' && p.sale_price) || '' %>"></div>
  </div>
</div>
