<%- include('../partials/header') %>
<%- include('../partials/pagehead', {
  heading: p.name, back: '/products',
  sub: `<span class="mono">${p.code}</span>` + (p.is_active ? ' <span class="badge text-bg-success">Đang bán</span>' : ' <span class="badge text-bg-secondary">Ngừng</span>'),
  actions: can('catalog.manage') ? `<form method="post" action="/products/${p.id}/delete" data-confirm="Xoá sản phẩm ${p.code}?"><button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i> Xoá</button></form>` : ''
}) %>
<% const editable = can('catalog.manage'); %>

<form method="post" action="/products/<%= p.id %>/variants" class="card">
  <div class="card-header d-flex justify-content-between align-items-center"><span>Biến thể (<%= variants.length %>)</span><% if (editable) { %><button class="btn btn-sm btn-primary" type="submit">Lưu biến thể</button><% } %></div>
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead><tr><th>Thuộc tính</th><th>SKU</th><th>Barcode</th><th class="num">Giá vốn</th><th class="num">Giá bán</th><th class="num">Mới</th><th class="num">Cũ</th><th class="num">Hỏng</th><th>Bán</th></tr></thead>
      <tbody>
        <% variants.forEach((v, i) => { %>
          <tr>
            <td><input type="hidden" name="variants[<%= i %>][id]" value="<%= v.id %>"><%= v.attrs || 'Mặc định' %></td>
            <% if (editable) { %>
              <td><input class="form-control form-control-sm mono" name="variants[<%= i %>][sku]" value="<%= v.sku %>" aria-label="SKU" style="min-width:170px"></td>
              <td><input class="form-control form-control-sm mono" name="variants[<%= i %>][barcode]" value="<%= v.barcode || '' %>" aria-label="Barcode" style="min-width:120px"></td>
              <td><input class="form-control form-control-sm text-end" type="number" min="0" step="1000" name="variants[<%= i %>][cost_price]" value="<%= v.cost_price %>" aria-label="Giá vốn" style="min-width:110px"></td>
              <td><input class="form-control form-control-sm text-end" type="number" min="0" step="1000" name="variants[<%= i %>][sale_price]" value="<%= v.sale_price %>" aria-label="Giá bán" style="min-width:110px"></td>
            <% } else { %>
              <td class="mono"><%= v.sku %></td><td class="mono"><%= v.barcode || '' %></td><td class="num"><%= fmt.money(v.cost_price) %></td><td class="num"><%= fmt.money(v.sale_price) %></td>
            <% } %>
            <td class="num"><a href="/stock?q=<%= encodeURIComponent(v.sku) %>"><%= fmt.num(v.qty_new) %></a></td>
            <td class="num"><%= fmt.num(v.qty_used) %></td>
            <td class="num"><%= fmt.num(v.qty_damaged) %></td>
            <td><input class="form-check-input" type="checkbox" name="variants[<%= i %>][is_active]" value="1" <%= v.is_active ? 'checked' : '' %> <%= editable ? '' : 'disabled' %> aria-label="Đang bán"></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</form>

<div class="row g-3">
  <div class="col-lg-6">
    <form method="post" action="/products/<%= p.id %>" class="card h-100">
      <div class="card-header">Thông tin sản phẩm</div>
      <fieldset class="card-body row g-3" <%= editable ? '' : 'disabled' %>>
        <div class="col-12"><label class="form-label" for="name">Tên sản phẩm</label><input class="form-control" id="name" name="name" value="<%= p.name %>" required></div>
        <div class="col-sm-7"><label class="form-label" for="category_id">Nhóm</label>
          <select class="form-select" id="category_id" name="category_id"><option value="">— Chọn —</option>
            <% categories.forEach(c => { %><option value="<%= c.id %>" <%= p.category_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
          </select>
        </div>
        <div class="col-sm-5"><label class="form-label" for="unit">Đơn vị tính</label><input class="form-control" id="unit" name="unit" value="<%= p.unit %>"></div>
        <div class="col-12"><label class="form-label" for="description">Mô tả</label><textarea class="form-control" id="description" name="description" rows="3"><%= p.description || '' %></textarea></div>
        <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="is_active" name="is_active" value="1" <%= p.is_active ? 'checked' : '' %>><label class="form-check-label" for="is_active">Đang kinh doanh</label></div></div>
      </fieldset>
      <% if (editable) { %><div class="card-footer"><button class="btn btn-primary" type="submit">Lưu thông tin</button></div><% } %>
    </form>
  </div>
  <% if (editable) { %>
  <div class="col-lg-6">
    <form method="post" action="/products/<%= p.id %>/generate" class="card h-100">
      <div class="card-header">Thêm biến thể</div>
      <div class="card-body d-flex flex-column gap-3">
        <p class="small text-body-secondary mb-0">Chọn giá trị, hệ thống chỉ tạo các tổ hợp chưa có.</p>
        <%- include('_attrpicker', { attributes, selected: {}, prefix: 'g' }) %>
      </div>
      <div class="card-footer"><button class="btn btn-outline-primary" type="submit">Tạo biến thể</button></div>
    </form>
  </div>
  <% } %>
</div>

<%- include('../partials/history', { logs }) %>
<%- include('../partials/footer') %>
